# Local development only. Never commit a real .env file or real credentials.

PORT=3000

# Canteen MySQL
CANTEEN_DB_HOST=
CANTEEN_DB_USER=
CANTEEN_DB_PASSWORD=
CANTEEN_DB_NAME=
CANTEEN_DB_PORT=3306
CANTEEN_DB_SSL=true
CANTEEN_DB_SSL_CA=
CANTEEN_DB_SSL_CA_FILE=/etc/secrets/canteen-ca.pem

# Lost & Found MySQL
LOST_FOUND_DB_HOST=
LOST_FOUND_DB_USER=
LOST_FOUND_DB_PASSWORD=
LOST_FOUND_DB_NAME=
LOST_FOUND_DB_PORT=3306
LOST_FOUND_DB_SSL=true
LOST_FOUND_DB_SSL_CA=
LOST_FOUND_DB_SSL_CA_FILE=/etc/secrets/lost-found-ca.pem

# Local development only. Never commit a real .env file or real credentials.

PORT=3000

# Canteen MySQL
CANTEEN_DB_HOST=
CANTEEN_DB_USER=
CANTEEN_DB_PASSWORD=
CANTEEN_DB_NAME=
CANTEEN_DB_PORT=3306

# Lost & Found MySQL
LOST_FOUND_DB_HOST=
LOST_FOUND_DB_USER=
LOST_FOUND_DB_PASSWORD=
LOST_FOUND_DB_NAME=
LOST_FOUND_DB_PORT=3306
# Aiven MySQL TLS CA certificate, copied into Render as a multiline environment variable.
# Keep this empty for non-TLS local MySQL.
LOST_FOUND_DB_SSL_CA=

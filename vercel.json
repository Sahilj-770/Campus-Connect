{
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/lost_and_found/uploads/:path*"
    },
    {
      "source": "/api/lost-found/:path*",
      "destination": "https://campus-connect-4n2t.onrender.com/api/lost-found/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://campus-connect-1-0q94.onrender.com/api/:path*"
    },
    {
      "source": "/food-images/:path*",
      "destination": "https://campus-connect-1-0q94.onrender.com/food-images/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/lost_and_found/lost.php",
      "destination": "/lost_and_found/lost.html",
      "permanent": false
    },
    {
      "source": "/lost_and_found/lost-items.php",
      "destination": "/lost_and_found/lost-items.html",
      "permanent": false
    },
    {
      "source": "/lost_and_found/found-items.php",
      "destination": "/lost_and_found/found-items.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
